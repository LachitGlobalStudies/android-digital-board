<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/color_white">
    <item android:id="@android:id/statusBarBackground">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/colorPrimaryDark"/>
            <size
                android:height="25dp"
                android:width="25dp"/>
            <solid android:color="@color/color_yellow"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:id="@android:id/background"
        android:height="20dp"
        android:width="20dp"
        android:drawable="@drawable/ic_baseline_stop_24"/>
</ripple>
