<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/color_white">
    <item android:id="@android:id/statusBarBackground">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/color_red"/>
            <size
                android:height="25dp"
                android:width="25dp"/>
            <solid android:color="@color/color_white"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:id="@android:id/background"
        android:height="18dp"
        android:width="18dp"
        android:drawable="@drawable/icons8_edit_100"/>
</ripple>
