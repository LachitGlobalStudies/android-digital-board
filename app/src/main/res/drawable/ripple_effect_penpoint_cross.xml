<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/color_white">
    <item
        android:gravity="center"
        android:id="@android:id/background"
        android:height="18dp"
        android:width="18dp"
        android:drawable="@drawable/pencil_48"/>
    <item>
        <rotate android:fromDegrees="90">
            <shape android:shape="line">
                <size
                    android:height="25dp"
                    android:width="25dp"/>
                <stroke
                    android:width="1dp"
                    android:color="@color/color_red"/>
            </shape>
        </rotate>
    </item>
</ripple>
