<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#cf0b4e"
                android:endColor="#e11f11"
                android:angle="45"
                android:gradientRadius="360"
                android:centerColor="#9c10b5"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="250dp"
                android:bottomRightRadius="250dp"/>
            <gradient
                android:startColor="#03a9f4"
                android:endColor="#cddc39"
                android:angle="45"
                android:gradientRadius="360"
                android:centerColor="#9c10b5"/>
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="50dp"
        android:right="0dp"
        android:bottom="50dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="250dp"
                android:bottomRightRadius="250dp"/>
            <gradient
                android:startColor="#cf0b4e"
                android:endColor="#e11f11"
                android:angle="45"
                android:gradientRadius="360"
                android:centerColor="#9c10b5"/>
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="100dp"
        android:right="0dp"
        android:bottom="100dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="250dp"
                android:bottomRightRadius="250dp"/>
            <gradient
                android:startColor="#b32a59"
                android:endColor="#ff5722"
                android:angle="45"
                android:gradientRadius="360"
                android:centerColor="#ffc107"/>
            <stroke
                android:width="0dp"
                android:color="@color/colorAccent"/>
        </shape>
    </item>
</layer-list>
