<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/backgrnd_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="30sp"
        android:textColor="@color/color_white"
        android:id="@+id/headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/important_info"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/baumans"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bar_ln"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/headline"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textColor="@color/color_white"
        android:id="@+id/first_run_text"
        android:padding="@dimen/start_5dp"
        android:scrollbars="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/adding_text"
        android:maxLines="15"
        android:layout_below="@+id/bar_ln"
        android:fontFamily="@font/baumans"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <Button
        android:textColor="@color/colorPrimaryDark"
        android:id="@+id/button_ok"
        android:background="@drawable/backgrnd_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/ok_btn"
        android:layout_below="@+id/first_run_text"
        android:fontFamily="@font/baumans"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
