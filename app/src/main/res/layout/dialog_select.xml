<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/backgrnd_trans"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="5dp">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/select_orientation"
        android:fontFamily="@font/baumans"
        android:textAlignment="center"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:weightSum="2">
        <ImageView
            android:id="@+id/portrait"
            android:paddingTop="10dp"
            android:layout_width="50dp"
            android:layout_height="150dp"
            android:layout_weight="1"
            android:contentDescription="@string/portrait_mode"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            app:srcCompat="@drawable/backgrnd_white"/>
        <ImageView
            android:id="@+id/landscape"
            android:paddingTop="40dp"
            android:paddingBottom="40dp"
            android:layout_width="50dp"
            android:layout_height="150dp"
            android:layout_weight="1"
            android:contentDescription="@string/landscape_mode"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:srcCompat="@drawable/backgrnd_white"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:weightSum="2">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/portrait_mode"
            android:layout_weight="1"
            android:fontFamily="@font/baumans"
            android:textAlignment="center"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/landscape_mode"
            android:layout_weight="1"
            android:fontFamily="@font/baumans"
            android:textAlignment="center"/>
    </LinearLayout>
</LinearLayout>
