<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/setting_layout"
    android:padding="3dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/color_bright_red"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/background_setting"
                android:layout_weight="1"
                android:fontFamily="@font/baumans"/>
            <ImageView
                android:id="@+id/back_cancel"
                android:layout_width="33dp"
                android:layout_height="25dp"
                android:layout_margin="2dp"
                android:src="@drawable/ic_twotone_cancel_24"
                android:contentDescription="@string/background_line"/>
        </LinearLayout>
        <View
            android:background="@color/color_red"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <HorizontalScrollView
            android:background="@color/icon_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/back_border"
                    android:background="@drawable/backgrnd_white"
                    android:padding="3dp"
                    android:layout_width="33dp"
                    android:layout_height="25dp"
                    android:layout_margin="2dp"
                    android:contentDescription="@string/background_setting"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/back_green"
                    android:background="@color/color_green_board"
                    android:padding="3dp"
                    android:layout_width="33dp"
                    android:layout_height="25dp"
                    android:layout_margin="2dp"
                    android:contentDescription="@string/background_setting"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/back_white"
                    android:layout_width="33dp"
                    android:layout_height="25dp"
                    android:layout_margin="2dp"
                    android:src="@color/color_white"
                    android:contentDescription="@string/background_setting"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/back_black"
                    android:layout_width="33dp"
                    android:layout_height="25dp"
                    android:layout_margin="2dp"
                    android:src="@color/color_black"
                    android:contentDescription="@string/background_setting"/>
                <ImageView
                    android:id="@+id/back_lines"
                    android:layout_width="33dp"
                    android:layout_height="25dp"
                    android:layout_margin="2dp"
                    android:src="@drawable/line"
                    android:contentDescription="@string/background_line"/>
                <ImageView
                    android:id="@+id/back_table"
                    android:background="@drawable/icons8_table_80"
                    android:layout_width="33dp"
                    android:layout_height="25dp"
                    android:layout_margin="2dp"
                    android:contentDescription="@string/background_checks"/>
                <ImageView
                    android:id="@+id/back_image"
                    android:background="@drawable/ic_baseline_image_24"
                    android:layout_width="33dp"
                    android:layout_height="25dp"
                    android:layout_margin="2dp"
                    android:contentDescription="@string/gallery_image_background"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/color_multi"
                    android:background="@drawable/icons8_color_wheel"
                    android:padding="3dp"
                    android:layout_width="33dp"
                    android:layout_height="25dp"
                    android:layout_margin="2dp"
                    android:contentDescription="@string/background_colors"/>
            </LinearLayout>
        </HorizontalScrollView>



    </LinearLayout>
</ScrollView>