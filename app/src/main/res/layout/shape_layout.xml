<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/shape_layout"
    android:background="@drawable/backgrnd_white"
    android:padding="3dp"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_line"
        android:padding="5dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/line"
        app:srcCompat="@drawable/ic_baseline_horizontal_rule_24"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_rect"
        android:padding="4dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/rectangle"
        app:srcCompat="@drawable/ic_baseline_check_box_outline_blank_24"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_tri"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/triangle"
        app:srcCompat="@drawable/ic_baseline_change_history_24"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_cir"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/circle"
        app:srcCompat="@drawable/ic_baseline_radio_button_unchecked_24"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_ellipse"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/circle"
        app:srcCompat="@drawable/ic_ellipse"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_poly"
        android:padding="4dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/hexagon"
        app:srcCompat="@drawable/ic_hexagon"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_poly_plus"
        android:background="@drawable/ripple_effect"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/add"
        app:srcCompat="@drawable/ic_baseline_add_24"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/shape_poly_num"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:text="3"
        android:textAlignment="gravity"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_poly_minus"
        android:background="@drawable/ripple_effect"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/substract"
        app:srcCompat="@drawable/ic_baseline_horizontal_rule_24"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_dashline"
        android:padding="4dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/hexagon"
        app:srcCompat="@drawable/ic_baseline_power_input_24"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_arrow_line"
        android:padding="4dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/hexagon"
        app:srcCompat="@drawable/ic_baseline_arrow_right_alt_24"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_cylinder"
        android:padding="4dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/_3d_shapes"
        app:srcCompat="@drawable/cylinder_3d"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_shpere"
        android:padding="4dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/_3d_shapes"
        app:srcCompat="@drawable/shpere_3d"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_cone"
        android:padding="4dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/_3d_shapes"
        app:srcCompat="@drawable/cone_3d"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/shape_cube"
        android:padding="4dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/hexagon"
        app:srcCompat="@drawable/cube_3d"/>
</LinearLayout>
