<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:id="@+id/text_bar_menu"
    android:background="@drawable/backgrnd_white"
    android:paddingLeft="@dimen/start_5dp"
    android:paddingRight="@dimen/start_5dp"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageButton
        android:id="@+id/delete_text"
        android:background="@drawable/ic_baseline_cancel_24"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:contentDescription="@string/cancel_text"/>
    <ImageButton
        android:id="@+id/left_align_text"
        android:background="@drawable/ic_baseline_format_align_left_24"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:contentDescription="@string/left_alignment"/>
    <ImageButton
        android:id="@+id/centre_align_text"
        android:background="@drawable/ic_baseline_format_align_center_24"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:contentDescription="@string/centre_alignment"/>
    <ImageButton
        android:id="@+id/right_align_text"
        android:background="@drawable/ic_baseline_format_align_right_24"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:contentDescription="@string/right_alignment_text"/>
    <ImageButton
        android:id="@+id/justify_text"
        android:background="@drawable/ic_baseline_format_align_justify_24"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:contentDescription="@string/justify_text"/>
    <ImageButton
        android:id="@+id/size_bold"
        android:background="@drawable/ic_baseline_format_bold_24"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:contentDescription="@string/text_bold"/>
    <ImageButton
        android:id="@+id/ok_text"
        android:background="@drawable/ic_baseline_check_circle_24"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:contentDescription="@string/set_text_to_page"/>
</LinearLayout>
