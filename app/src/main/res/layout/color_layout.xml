<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/color_layout"
    android:padding="3dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/color_red"
        android:background="@drawable/ripple_effect"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/color_red"
        app:srcCompat="@drawable/red_circle"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/color_black"
        android:background="@drawable/ripple_effect"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/color_black"
        app:srcCompat="@drawable/black_circle"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/color_White"
        android:background="@drawable/ripple_effect"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/color_white"
        app:srcCompat="@drawable/white_circle"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/color_purple"
        android:background="@drawable/ripple_effect"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/color_purple"
        app:srcCompat="@drawable/purple_circle"/>

    <ImageView
        android:layout_gravity="center"
        android:id="@+id/color_green"
        android:background="@drawable/ripple_effect"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/color_green"
        app:srcCompat="@drawable/green_circle"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/color_blue"
        android:background="@drawable/ripple_effect"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/color_blue"
        app:srcCompat="@drawable/blue_circle"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/color_yellow"
        android:background="@drawable/ripple_effect"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/color_yellow"
        app:srcCompat="@drawable/yellow_circle"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/color_orange"
        android:background="@drawable/ripple_effect"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/color_orange"
        app:srcCompat="@drawable/orrange_circle"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/color_wheel"
        android:background="@drawable/ripple_effect"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="2dp"
        android:contentDescription="@string/color_wheel"
        app:srcCompat="@drawable/icons8_color_wheel"/>
</LinearLayout>
