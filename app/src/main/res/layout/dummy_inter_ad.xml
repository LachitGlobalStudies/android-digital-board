<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="30dp"
    android:layout_marginBottom="30dp"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="30dp"
    android:elevation="@dimen/start_5dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="10dp"
    app:cardMaxElevation="10dp">
    <RelativeLayout
        android:id="@+id/dummy_ads_layout"
        android:background="@drawable/blur_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/btn_exit"
            android:background="@drawable/ripple_effect"
            android:padding="3dp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_baseline_clear_24"
            android:layout_alignParentTop="true"
            android:contentDescription="@string/cancel"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textColor="@color/color_white"
            android:id="@+id/time_remain"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/time_remaining"
            android:layout_alignParentTop="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/start_5dp"
                app:cardCornerRadius="10dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/my_ad_view"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/ic_launcher_playstore"
                    android:elevation="10dp"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:layout_gravity="center"
                android:id="@+id/exittext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/ramsoftsolution"
                android:shadowColor="@color/color_black"
                android:shadowDx="5"
                android:shadowDy="9"
                android:shadowRadius="11"
                android:fontFamily="@font/baumans"
                android:textAlignment="center"/>
            <TextView
                android:textSize="35sp"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/whiteboard"
                android:shadowColor="@color/color_black"
                android:shadowDx="5"
                android:shadowDy="9"
                android:shadowRadius="11"
                android:fontFamily="@font/baumans"
                android:textAlignment="center"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
